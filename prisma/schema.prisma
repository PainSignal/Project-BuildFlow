// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Organization model - top level entity for multi-tenancy
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  clients     Client[]
  projects    Project[]
  invites     Invite[]
  activityLog ActivityLog[]

  // Subscription fields
  subscriptionTier    String?    // solo, team, growth
  subscriptionStatus  String?    // active, past_due, cancelled, expired
  subscriptionId      String?    // Lemon Squeezy subscription ID
  customerId          String?    // Lemon Squeezy customer ID
  trialEndsAt         DateTime?  // Trial expiration date
  subscriptionEndsAt  DateTime?  // Subscription renewal/cancel date
}

// User model
model User {
  id                 String     @id @default(cuid())
  orgId              String
  email              String     @unique
  name               String?
  passwordHash       String
  role               String     @default("member") // owner, admin, member
  onboardingCompleted Boolean  @default(false)
  digestEnabled      Boolean   @default(true) // Daily digest email preference
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tasks              Task[]     @relation("TaskAssignee")
  managedProjects    Project[]  @relation("ProjectManager")
  notifications      Notification[]
  activityLog        ActivityLog[]
  sentInvites        Invite[]   @relation("InviteSender")
  receivedInvites    Invite[]   @relation("InviteRecipient")
  clientNotes        ClientNote[]

  @@index([orgId])
}

// Invite model - for team invitations
model Invite {
  id           String   @id @default(cuid())
  orgId        String
  email        String
  token        String   @unique
  role         String   @default("member") // admin, member
  status       String   @default("pending") // pending, accepted, expired, revoked
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedById  String
  acceptedBy   User?    @relation("InviteRecipient", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedById String?
  acceptedAt   DateTime?

  @@index([orgId])
  @@index([email])
  @@index([token])
}

// Client model - customers of construction firms
model Client {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  email        String?
  phone        String?
  address      String?
  vatNumber    String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects     Project[]
  clientNotes  ClientNote[]

  @@index([orgId])
}

// Client Note model - notes and calls log for CRM
model ClientNote {
  id          String   @id @default(cuid())
  clientId    String
  orgId       String
  userId      String
  type        String   // note, call, email
  content     String
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([orgId])
}

// Project model
model Project {
  id               String          @id @default(cuid())
  orgId            String
  clientId         String?
  name             String
  description      String?
  status           String          @default("active") // active, on_hold, completed
  startDate        DateTime?
  endDate          DateTime?
  budget           Float?
  projectManagerId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client           Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectManager   User?           @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  tasks            Task[]
  permits          Permit[]
  purchaseOrders   PurchaseOrder[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([projectManagerId])
}

// Task model
model Task {
  id           String    @id @default(cuid())
  orgId        String
  projectId    String
  assigneeId   String?
  title        String
  description  String?
  status       String    @default("todo") // todo, in_progress, done
  priority     String    @default("medium") // low, medium, high
  taskType     String    @default("general") // general, permit, material, client
  blocked      Boolean   @default(false)
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId, dueDate])
  @@index([assigneeId])
}

// Permit model
model Permit {
  id           String   @id @default(cuid())
  orgId        String
  projectId    String
  name         String
  permitNumber String?
  status       String   @default("pending") // pending, submitted, approved, rejected
  deadline     DateTime
  notes        String?
  fileUrl      String?  // URL to uploaded permit document
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([projectId, deadline])
}

// Purchase Order model
model PurchaseOrder {
  id           String     @id @default(cuid())
  orgId        String
  projectId    String
  vendor       String
  status       String     @default("draft") // draft, sent, confirmed, delivered, cancelled
  totalAmount  Float
  vatAmount    Float
  vatRate      Float
  orderDate    DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lineItems    LineItem[]

  @@index([orgId])
  @@index([projectId])
}

// Line Item model
model LineItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  description     String
  quantity        Int
  unitPrice       Float
  totalPrice      Float
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

// Activity Log model - insert-only audit trail
model ActivityLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  entityType String   // project, task, permit, purchase_order, client
  entityId   String
  action     String   // create, update, delete
  changes    Json?    // JSON object with before/after values
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, entityType, entityId])
  @@index([orgId, createdAt])
}

// Notification model
model Notification {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  type       String   // task_assigned, project_updated, mention, etc.
  title      String
  message    String?
  read       Boolean  @default(false)
  entityType String?  // project, task, etc.
  entityId   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId, read])
  @@index([userId, createdAt])
}
