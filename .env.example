# Database
# Supabase PostgreSQL connection string
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?pgbouncer=true
# Get your connection string from Supabase dashboard > Settings > Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"

# NextAuth.js
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Cron Jobs
CRON_SECRET="your-cron-secret-here-generate-with-openssl-rand-base64-32"

# Payments (Lemon Squeezy)
LEMONSQUEEZY_API_KEY="xxxxxxxxxxxxxxxxxxxx"
LEMONSQUEEZY_STORE_ID="12345"
LEMONSQUEEZY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxx"

# Plan Variant IDs (from Lemon Squeezy dashboard)
LEMONSQUEEZY_SOLO_MONTHLY_VARIANT_ID="variant_id_here"
LEMONSQUEEZY_SOLO_ANNUAL_VARIANT_ID="variant_id_here"
LEMONSQUEEZY_TEAM_MONTHLY_VARIANT_ID="variant_id_here"
LEMONSQUEEZY_TEAM_ANNUAL_VARIANT_ID="variant_id_here"
LEMONSQUEEZY_GROWTH_MONTHLY_VARIANT_ID="variant_id_here"
LEMONSQUEEZY_GROWTH_ANNUAL_VARIANT_ID="variant_id_here"

# App Configuration
NODE_ENV="development"
